# The GPU check in a container with NVIDIA's CUDA 12.6 toolkit (nvcc, gcc).
# Needs the NVIDIA Container Toolkit on the host. Build and run:
#   docker build -f Dockerfile.gpu -t p9gpucheck . && docker run --rm --gpus all p9gpucheck
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*
WORKDIR /p9gpucheck
COPY . .
ENV NVCC=/usr/local/cuda/bin/nvcc CUDA_LIB=/usr/local/cuda/lib64
CMD ["sh", "run-gpucheck.sh"]
