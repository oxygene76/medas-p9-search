# chain.env: settings of chain-a100.sh and run-watch.sh (copy to chain.env next to the scripts; not secret).
# The directories of the unpacked packages (as in the start guide; adjust if yours differ):
PROD_DIR=$HOME/runs/prod/p9prod-9a084ed
V5_DIR=$HOME/runs/v5/p9long-v5-ac47329
SETS_DIR=$HOME/runs/sets/p9bbsets-5b05cc3
MERC_DIR=$HOME/runs/long/p9long-merc-ac47329
# The A100: by UUID (preferred; nvidia-smi -L) or, if GPU_UUID is empty, the first card whose name contains GPU_NAME
GPU_NAME=A100
GPU_UUID=
# Created by the operator once entry 4 is on chain (set A and B start only with it)
E4_OK=$HOME/runs/chain/e4-on-chain.ok
# Telegram: a file with two lines TELEGRAM_TOKEN=... and TELEGRAM_CHAT_ID=..., mode 600, owned by this user
TELEGRAM_FILE=$HOME/.config/p9chain/telegram.env
# Checks every INTERVAL s; alarm without a new file for STALL_MIN min (A100 runs) / STALL_MERC_MIN (MERCURIUS);
# open alarms again every REPEAT_H h; halt above TEMP_MAX deg C; reports at these hours (UTC)
INTERVAL=300
STALL_MIN=90
STALL_MERC_MIN=120
REPEAT_H=6
TEMP_MAX=85
REPORT_HOURS="07 19"
# The kernel log for Xid (as this user: needs the group systemd-journal, see README)
XID_CMD="journalctl -k -q --no-pager -o short-iso"
